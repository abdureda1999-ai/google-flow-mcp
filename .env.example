# Required: Your Google Gemini API Key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Default directory where generated videos and frames are saved
FLOW_MEDIA_DIR="./media"

# Optional: Default HTTP server host and port (used when running in --transport sse or --transport openapi mode for ChatGPT)
FLOW_HOST="127.0.0.1"
FLOW_PORT="8000"
